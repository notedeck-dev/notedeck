// Mi Light theme
// Source: misskey-dev/misskey packages/frontend-shared/themes/l-light.json5
{
  id: '4eea646f-7afa-4645-83e9-83af0333cd37',
  name: 'Mi Light',
  author: 'syuilo',
  desc: 'Default light theme',
  base: 'light',
  props: {
    bg: '#f9f9f9',
    fg: '#676767',
    fgOnWhite: '@accent',
    divider: '#e8e8e8',
    header: ':alpha<0.7<@panel',
    navBg: '#fff',
    panel: '#fff',
    // ここから NoteDeck 独自 (#1213): 文字として読む色だけを、本家の色を
    // 色相そのままに暗くして bg / panel に対し 4.5:1 以上にする。
    // 塗りに使う accent は本家の色のまま
    link: ':darken<14<#44a4c1',
    hashtag: ':darken<28<#ff9156',
    accentText: ':darken<11<@accent',
    mention: '@accentText',
    mentionMe: ':darken<10<rgb(0, 179, 70)',
  },
}

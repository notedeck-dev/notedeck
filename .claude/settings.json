{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm fmt*)",
      "Bash(pnpm doctor*)",
      "Bash(pnpm changelog*)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(cargo check*)",
      "Bash(cargo test*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)"
    ]
  }
}

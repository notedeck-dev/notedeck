      description: '指定 userId をミュートする (ノート + 通知が見えなくなる)。相手に通知は飛ばない。リノートだけ消したいなら user.renoteMute を使う。',
      params: {
        userId: {
          type: 'string',
          description: '対象 userId (user.lookup / search で取得)',
        },
        accountId: {
          type: 'string',
          description: '操作元アカウント。未指定なら active。',
          optional: true,
        },
      },
      returns: {
        type: 'object',
        description: '{ muted: true, userId }',
      },
    },
    'user.renoteMute': {
      destinations: ['userId'],
      label: 'リノートだけミュート',
      category: 'account',
      icon: 'ti-volume-3',
      permissions: [
        'account.write',
      ],
      confirm: true,
      actsAsAccount: true,
      exec: 'device',
      description: '指定 userId のリノートだけを非表示にする (オリジナル投稿は見える)。user.mute と独立に動作。',
      params: {
        userId: {
          type: 'string',
          description: '対象 userId (user.lookup / search で取得)',
        },
        accountId: {
          type: 'string',
          description: '操作元アカウント。未指定なら active。',
          optional: true,
        },
      },
      returns: {
        type: 'object',
        description: '{ renoteMuted: true, userId }',
      },
    },
    'user.search': {
      untrusted: true,
      label: 'ユーザーをあいまい検索',
      category: 'account',
      icon: 'ti-search',
      permissions: [
        'account.read',
      ],
      cheap: true,
      exec: 'core',
      description: 'username / display name の部分一致でユーザーを検索する (Misskey `users/search-by-username-and-name` 相当)。空 query なら最近やり取りしたユーザー一覧。完全一致での 1 件引きは user.lookup を使う。',
      params: {
        query: {
          type: 'string',
          description: '検索文字列 (空文字なら最近のユーザー一覧)',
        },
        limit: {
          type: 'number',
          description: '取得件数 (1-100, default 10)',
          optional: true,
        },
        accountId: {
          type: 'string',
          description: 'どのアカウントの adapter で検索するか。未指定なら active アカウント。',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: 'NormalizedUser の配列 (id / username / host / name / avatarUrl)',
      },
    },
    'user.unfollow': {

{
  schemaVersion: 1,
  placeholders: {
    accountIdParamDesc: 'どのアカウントで実行するか。未指定なら呼び出し文脈のアカウント (per-account の AI カラムならそのアカウント)。全アカウントのカラムや HEARTBEAT には文脈アカウントが無いので、`account.list` か `<currentColumn>.accountId` から選んで必ず渡す。',
    accountIdHint: '`accountId` 未指定なら呼び出し文脈のアカウント (per-account の AI カラムならその アカウント) を使う。文脈が無い全アカウントのカラムでは `account.list` か `<currentColumn>.accountId` から選んで渡す。',
    scopeParamDesc: 'registry の scope 配列 (= path components)。例: `["client"]` / `["client","misskey"]`。Misskey 公式 UI と共有される設定エリア。',
  },
  // 権限キーの語彙 (#712)。順序は UI / golden vector のキー順。TS (src/permissions/keys.generated.ts) と
  // Rust (crates/notecore/src/permissions_keys.generated.rs) はここから生成する。
  //   presets: どの preset で ON か (full は常に ON なので書かない)
  //   highRisk: UI に warning を出す / aiInstruction: AI の指示チャネル (第三者に恒久 deny)
  //   thirdPartyDeny: plugin / external に恒久 deny / externalReadFloor: external の read 下限 (常時 ON)
  //   localRead: NoteDeck ローカル私的データの read (external の既定から落とす)
  permissions: {
    'notes.read': { presets: ['readonly', 'safe'], externalReadFloor: true },
    // 手元の索引 (キャッシュ) の横断検索 (#947)。サーバー検索では見えないフォロワー限定 / ダイレクトも索引にあるので notes.read とは分け、既定は閉じる
    'notes.readArchive': { presets: [], localRead: true },
    'notes.write': { presets: [], highRisk: true },
    'notes.react': { presets: ['safe'] },
    'account.read': { presets: ['readonly', 'safe'], externalReadFloor: true },
    'account.write': { presets: [], highRisk: true },
    // クロスアカウント実行 (#777): 呼び出し文脈と異なるアカウントを明示指定して capability を実行する権利。actsAsAccount 宣言付き capability に対して dispatcher が検査する。user principal は対象外
    'account.actAs': { presets: [], highRisk: true },
    'drive.read': { presets: ['readonly', 'safe'], externalReadFloor: true },
    'drive.write': { presets: [], highRisk: true },
    'memos.read': { presets: ['readonly', 'safe'], localRead: true },
    'memos.write': { presets: ['safe'], highRisk: true },
    'clips.read': { presets: ['readonly', 'safe'], externalReadFloor: true },
    'clips.write': { presets: ['safe'] },
    'drafts.read': { presets: ['readonly', 'safe'], localRead: true },
    'drafts.write': { presets: ['safe'] },
    'network.external': { presets: [], highRisk: true },
    'clipboard': { presets: ['safe'] },
    'notifications': { presets: ['safe'] },
    'tasks.run': { presets: ['safe'], highRisk: true, thirdPartyDeny: true },
    'ai.invoke': { presets: ['safe'] },
    'ai.persona.write': { presets: [], highRisk: true, aiInstruction: true, thirdPartyDeny: true },
    'skills.read': { presets: ['readonly', 'safe'], localRead: true },
    'skills.write': { presets: ['safe'], highRisk: true, aiInstruction: true, thirdPartyDeny: true },
    'theme.write': { presets: [] },
    'styles.write': { presets: [] },
    'navbar.write': { presets: [] },
    'keybinds.write': { presets: [] },
    'performance.write': { presets: [] },
    'widgets.read': { presets: ['readonly', 'safe'], localRead: true },
    'widgets.write': { presets: ['safe'] },
    'plugins.read': { presets: ['readonly', 'safe'], localRead: true },
    'plugins.write': { presets: ['safe'] },
    // カラムクエリ (#1117)。名前付きクエリの編集履歴の読取と、履歴からの復元
    'queries.read': { presets: ['readonly', 'safe'], localRead: true },
    'queries.write': { presets: ['safe'] },
    'ai.sessions.read': { presets: ['readonly', 'safe'], localRead: true },
    'logs.read': { presets: ['readonly', 'safe'], localRead: true },
    'vault.use': { presets: [], highRisk: true },
    // ローカルディスクへのファイル書き出し (#813)。Downloads/notedeck 配下に固定されるが、ユーザーのディスクに成果物を作る操作なので write 系
    'files.export': { presets: [], highRisk: true },
    // DB + 設定のバックアップ作成 (#816)。成果物にローカルのノートキャッシュ全量が含まれるため write 系かつ高リスク
    'backup.create': { presets: [], highRisk: true, thirdPartyDeny: true },
    // デッキ構成 (カラム一覧 = 検索クエリ / アンテナ名 / アカウント紐付け等のローカル私的データ) の read (#712 §5.3)。external のみ既定 OFF
    'deck.read': { presets: ['readonly', 'safe'], localRead: true },
    // デッキ / ウィンドウ構成の変更 (#1098)。従来は無条件許可だったため readonly の heartbeat や外部トークンでもデッキを消せた。readonly のみ false
    'deck.write': { presets: ['safe'] },
  },
  // destinations: 書き込みの宛先になる引数 (返信先 / 対象ユーザー / URL など)。値の出所を
  //   3 値 (ユーザー入力 / 信頼済み結果 / untrusted 本文中) で判定し、3 番目なら確認に一文添えて記憶の対象外にする
  // untrusted: 結果に他人の内容 (投稿 / プロフィール / 通知 / fetch 結果) を含みうる読取。
  //   読んだセッションは以後 tainted になり、書き込みは「次から確認しない」を無視して確認する (#1103 / #1133)
  capabilities: {
    'account.current': {
      label: '現在のアカウント情報',
      category: 'account',
      icon: 'ti-user',
      permissions: [
        'account.read',
      ],
      cheap: true,
      exec: 'core',
      description: '呼び出し文脈のアカウント (per-account の AI カラムならそのアカウント) の情報を返す。全アカウントのカラムや HEARTBEAT では null。 Misskey サーバーの host や displayName, username 等が含まれる。 認証トークンは含まれない。',
      returns: {
        type: 'object',
        description: '`{ id, host, userId, username, displayName, avatarUrl, software, hasToken }` (文脈アカウントが無いときは null)',
      },
    },
    'account.list': {
      label: 'アカウント一覧',
      category: 'account',
      icon: 'ti-users',
      permissions: [
        'account.read',
      ],
      cheap: true,
      exec: 'core',
      description: 'NoteDeck にログイン中の全アカウントを配列で返す。複数サーバーを 横断したい場合に使う。認証トークンは含まれない。',
      returns: {
        type: 'array',
        description: 'Account の配列',
      },
    },
    'ai.chat': {
      label: 'AI に問い合わせる',
      category: 'general',
      icon: 'ti-sparkles',
      permissions: [
        'ai.invoke',
      ],
      aiTool: false,
      visible: true,
      exec: 'device',
      description: 'NoteDeck の AI に 1 ターンだけ問い合わせて応答テキストを得る。AiScript プラグインや外部 API / CLI から呼ぶ用途。AI チャット本体からの自己再帰呼出しは aiTool:false で塞がれている。',
      params: {
        prompt: {
          type: 'string',
          description: 'ユーザー側プロンプト (= user role の content)',
        },
        system: {
          type: 'string',
          description: 'システムプロンプト (= AI に与える役割設定)',
          optional: true,
        },
        model: {
          type: 'string',
          description: 'モデル override (省略時は現在の AI 設定を使う)',
          optional: true,
        },
        maxTokens: {
          type: 'number',
          description: '最大トークン数 (省略時はプロバイダのデフォルト)',
          optional: true,
        },
      },
      returns: {
        type: 'object',
        description: '{ response: string }',
      },
    },
    'ai.listPersonas': {
      label: 'persona 用 skill 一覧',
      category: 'general',
      icon: 'ti-user-circle',
      permissions: [
        'skills.read',
      ],
      cheap: true,
      exec: 'device',
      description: 'persona として選べる skill 一覧 (= isPersona:true な skill のみ)。 現在 active な persona は `active: true`。',
      returns: {
        type: 'array',
        description: '各要素は { id, name, description, mode, scope, active: boolean }',
      },
    },
    'ai.sessions.list': {
      label: 'AI セッション一覧',
      category: 'general',
      icon: 'ti-messages',
      permissions: [
        'ai.sessions.read',
      ],
      cheap: true,
      exec: 'core',
      description: '保存されている AI セッションのメタ一覧 (updatedAt 降順) を返す。 各エントリは { id, kind, title, updatedAt, messageCount }。',
      returns: {
        type: 'array',
        description: 'AiSessionMeta の配列',
      },
    },
    'ai.sessions.read': {
      untrusted: true,
      label: 'AI セッションを読む',
      category: 'general',
      icon: 'ti-message-2',
      permissions: [
        'ai.sessions.read',
      ],
      cheap: true,
      exec: 'core',
      description: '指定 id の AI セッションのメッセージ列を返す。',
      params: {
        id: {
          type: 'string',
          description: '対象セッションの id',
        },
      },
      returns: {
        type: 'object',
        description: '{ id, kind, title, messages: [{ role, content }] }',
      },
    },
    'ai.sessions.search': {
      untrusted: true,
      label: 'AI セッション本文を検索',
      category: 'general',
      icon: 'ti-search',
      permissions: [
        'ai.sessions.read',
      ],
      cheap: true,
      exec: 'core',
      description: '保存されている AI セッションのメッセージ本文を全文 grep して、ヒットしたセッションを id + 周辺 snippet で返す。大文字小文字を無視。',
      params: {
        query: {
          type: 'string',
          description: '検索クエリ (部分一致)',
        },
        limit: {
          type: 'number',
          description: '最大返却数 (default: 20)',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: '[{ id, title, snippet }] の配列',
      },
    },
    'ai.setPersona': {
      label: 'AI persona を切替',
      category: 'general',
      icon: 'ti-user-circle',
      permissions: [
        'ai.persona.write',
      ],
      confirm: true,
      exec: 'device',
      description: 'AI の persona (= 同一性設定) を切り替える。skillId は isPersona:true な skill の id (ai.listPersonas で取得)、空文字を渡せば persona 解除。 chat / heartbeat / command / task すべての AI session に反映される。',
      params: {
        skillId: {
          type: 'string',
          description: '新しい persona skill id (空文字で解除 = 通常の汎用 AI)',
        },
      },
      returns: {
        type: 'object',
        description: '{ personaSkillId: string, persona: { id, name } | null }',
      },
    },
    'aiscript.logs': {
      label: 'AiScript 実行ログを取得',
      category: 'general',
      icon: 'ti-bug',
      permissions: [
        'logs.read',
      ],
      cheap: true,
      exec: 'device',
      description: 'AiScript (プラグイン/ウィジェット/Play/Page/スクラッチパッド) の実行ログを新しい順に返す。print 出力は level "print"、実行時エラーは "error"、起動 (started)・正常終了 (run completed)・parse 失敗・runtime abort は "system"。プラグイン/ウィジェットを保存して実行された後は必ずこれを source / sourceId で絞って確認し、error や parse 失敗があれば src を修正して再保存するループを回すこと。3 回試して直らないならログをユーザーに見せて相談する。',
      params: {
        source: {
          type: 'string',
          description: '"plugin" | "widget" | "play" | "page" | "playground" | "all" (default: "all")',
          optional: true,
          enum: [
            'plugin',
            'widget',
            'play',
            'page',
            'playground',
            'all',
          ],
        },
        sourceId: {
          type: 'string',
          description: 'installId (plugin/widget) や Play/Page の id で絞り込む (省略可)',
          optional: true,
        },
        level: {
          type: 'string',
          description: '"print" | "error" | "system" | "all" (default: "all")',
          optional: true,
          enum: [
            'print',
            'error',
            'system',
            'all',
          ],
        },
        limit: {
          type: 'number',
          description: '最大返却数 (default: 50)',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: '{ at, source, sourceId, name?, runId, level, message } の配列 (新しい順)。runId は実行ごとの通し番号で、同じ runId = 同じ実行。',
      },
    },
    'aiscript.validate': {
      label: 'AiScript を構文検証する',
      category: 'general',
      icon: 'ti-check',
      permissions: [],
      cheap: true,
      exec: 'device',
      description: 'AiScript ソースを構文検証し、エラー一覧を返す。プラグイン/ウィジェットを `plugins.create` / `plugins.update` / `widgets.create` / `widgets.update`で保存する前に必ず通して、diagnostics が空でなければ src を修正して再度validate するループを回すこと。3 回試して直らないなら diagnostics をユーザーに見せて相談する。',
      params: {
        src: {
          type: 'string',
          description: 'AiScript ソースコード',
        },
        entryPoint: {
          type: 'string',
          description: '\'plugin\' | \'widget\' (省略可)',
          optional: true,
        },
      },
      returns: {
        type: 'object',
        description: '{ ok: boolean, diagnostics: Array<{severity, message, line, column, endLine, endColumn}> }。line / column は 1-based。',
      },
    },
    'announcements.list': {
      untrusted: true,
      label: 'サーバーアナウンス一覧',
      category: 'account',
      icon: 'ti-megaphone',
      permissions: [
        'account.read',
      ],
      cheap: true,
      exec: 'core',
      description: 'Misskey サーバーのアナウンス一覧を返す (read-only)。isActive=true (default) で現在有効なアナウンスのみ、false で過去含む。既読化は副作用ありのため 本 capability では提供しない (取得のみ)。',
      params: {
        limit: {
          type: 'number',
          description: '取得件数 (default 30, 1-100)',
          optional: true,
        },
        isActive: {
          type: 'boolean',
          description: '現在有効なアナウンスのみ (default: true)',
          optional: true,
        },
        accountId: {
          type: 'string',
          description: '${accountIdParamDesc}',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: 'Announcement の配列',
      },
    },
    'antenna.list': {
      label: '自分のアンテナ一覧',
      category: 'account',
      icon: 'ti-antenna',
      permissions: [
        'account.read',
      ],
      cheap: true,
      exec: 'core',
      description: '自分が定義した Misskey アンテナの一覧を返す。各要素は { id, name, keywords, users, ... }。antenna.notes で notes を取るときの起点。',
      params: {
        accountId: {
          type: 'string',
          description: '${accountIdParamDesc}',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: 'Antenna の配列',
      },
    },
    'antenna.notes': {
      untrusted: true,
      label: 'アンテナの note',
      category: 'note',
      icon: 'ti-antenna-bars-5',
      permissions: [
        'notes.read',
      ],
      exec: 'core',
      description: '指定アンテナにマッチした note を返す。antennaId は antenna.list で取得。 projection された note (id / userId / username / text / createdAt) を最大 limit 件返す。',
      params: {
        antennaId: {
          type: 'string',
          description: '対象 antennaId',
        },
        limit: {
          type: 'number',
          description: '取得件数 (default 20)',
          optional: true,
        },
        untilId: {
          type: 'string',
          description: 'untilId (古い方向のページング)',
          optional: true,
        },
        accountId: {
          type: 'string',
          description: '${accountIdParamDesc}',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: 'projected note の配列',
      },
    },
    'backup.create': {
      label: 'バックアップを作成',
      category: 'general',
      icon: 'ti-database-export',
      permissions: [
        'backup.create',
      ],
      confirm: true,
      // HEARTBEAT からは確認なしで定期実行できる (#816)。権限 (既定 false) だけで gate
      unattended: true,
      exec: 'device',
      description: 'ローカル DB と設定のスナップショットを Downloads/notedeck/backup/ に 作成する。認証情報は含まれない。デッキ構成やプラグイン登録は対象外。 DB と設定はそれぞれ独立して選べる (既定は両方)。 世代は新しい順に keep 件だけ残る。',
      params: {
        includeDb: {
          type: 'boolean',
          description: 'ローカル DB を含める (default: true)',
          optional: true,
        },
        includeSettings: {
          type: 'boolean',
          description: '設定ファイル一式を含める (default: true)',
          optional: true,
        },
        keep: {
          type: 'number',
          description: '残す世代数 (1〜100、default: 10)',
          optional: true,
        },
      },
      returns: {
        type: 'object',
      },
    },
    'channel.list': {
      label: '自分のフォロー中チャネル',
      category: 'account',
      icon: 'ti-device-tv',
      permissions: [
        'account.read',
      ],
      cheap: true,
      exec: 'core',
      description: '自分がフォロー中の Misskey チャネル一覧を返す。各要素は { id, name, description, ... }。channel.notes で channelId を渡すときの起点。',
      params: {
        accountId: {
          type: 'string',
          description: '${accountIdParamDesc}',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: 'Channel の配列',
      },
    },
    'channel.notes': {
      untrusted: true,
      label: 'チャネルの note',
      category: 'note',
      icon: 'ti-message-circle',
      permissions: [
        'notes.read',
      ],
      exec: 'core',
      description: '指定チャネルの note を返す。channelId は channel.list で取得。 projection された note (id / userId / username / text / createdAt) を最大 limit 件返す。',
      params: {
        channelId: {
          type: 'string',
          description: '対象 channelId',
        },
        limit: {
          type: 'number',
          description: '取得件数 (default 20)',
          optional: true,
        },
        untilId: {
          type: 'string',
          description: 'untilId (古い方向のページング)',
          optional: true,
        },
        accountId: {
          type: 'string',
          description: '${accountIdParamDesc}',
          optional: true,
        },
      },
      returns: {
        type: 'array',
        description: 'projected note の配列',
      },
    },
    'chat.react': {
      destinations: ['messageId'],
      label: 'チャットメッセージにリアクション',
      category: 'note',
      icon: 'ti-mood-smile',
      permissions: [
        'notes.react',
      ],
      confirm: true,
      actsAsAccount: true,
      exec: 'core',
      description: 'Misskey 新 Chat (v2025) のメッセージにリアクションを付ける。reaction は `:name:` 形式または Unicode 絵文字。messageId は chat カラム表示中のメッセージから取得する想定。',
      params: {
        messageId: {
          type: 'string',
          description: '対象メッセージ id',
        },
        reaction: {
          type: 'string',
          description: 'リアクション (`:thinking_face:` / `👍` 等)',
        },
        accountId: {
          type: 'string',
          description: '${accountIdParamDesc}',
          optional: true,
        },
      },
      returns: {
        type: 'object',
        description: '{ ok: true, messageId, reaction }',
      },
    },
    'chat.unreact': {
      destinations: ['messageId'],
      label: 'チャットメッセージのリアクションを解除',
      category: 'note',
      icon: 'ti-mood-x',
      permissions: [
        'notes.react',
      ],
      confirm: true,
      actsAsAccount: true,
      exec: 'core',
      description: 'Misskey Chat メッセージから自分のリアクションを解除する。reaction は 付けたときと同じ値 (チャットでは複数 reaction を 1 ユーザーが付けられるため、 note のリアクションと違って種別指定が必要)。',
      params: {
        messageId: {
          type: 'string',
          description: '対象メッセージ id',
        },
        reaction: {
          type: 'string',
          description: '解除する reaction 種別',
        },
        accountId: {
          type: 'string',
          description: '${accountIdParamDesc}',
          optional: true,
        },
      },
      returns: {
        type: 'object',
        description: '{ ok: true, messageId, reaction }',
      },
    },
    'clipboard.read': {
      label: 'クリップボードを読む',
      category: 'general',
      icon: 'ti-clipboard',
      permissions: [
        'clipboard',
      ],
      cheap: true,
      exec: 'device',
      description: 'OS クリップボードのテキストを返す。プラグインが「コピーしたテキストを AI で処理」のような flow を実現するために使う。',
      returns: {
        type: 'object',
        description: '{ text: string }',
      },
    },
    'clipboard.write': {
      label: 'クリップボードに書き込む',
      category: 'general',
      icon: 'ti-clipboard-copy',
      permissions: [
        'clipboard',
      ],
      exec: 'device',
      description: 'OS クリップボードに文字列を書き込む。AI が生成した訳文・要約をユーザーが他アプリへ貼り付けやすくするための出力経路。',
      params: {
        text: {
          type: 'string',
          description: 'クリップボードに書く文字列',
        },

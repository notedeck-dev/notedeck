          description: 'スキル一覧に表示される 1 行説明',
          optional: true,
        },
        mode: {
          type: 'string',
          description: '実行モード (default: manual)。always / heartbeat は影響が大きいのでユーザーが明示したときのみ',
          optional: true,
          enum: [
            'manual',
            'trigger',
            'always',
            'heartbeat',
          ],
        },
        triggers: {
          type: 'array',
          description: 'mode=trigger のとき必須。user 入力への部分一致でロードされる語の配列 (大文字小文字無視)',

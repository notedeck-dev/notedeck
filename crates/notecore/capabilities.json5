        author: {
          type: 'string',
          description: '作者表記',
          optional: true,
        },
        description: {
          type: 'string',
          description: '概要',
          optional: true,
        },
        permissions: {
          type: 'array',
          description: 'プラグインが要求する permission の配列 (Misskey 互換)',
          optional: true,
        },
      },
      returns: {

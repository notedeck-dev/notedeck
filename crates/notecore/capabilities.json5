        },
        cheapCheckCapabilities: {
          type: 'array',
          description: 'mode=heartbeat 用。変化検知に使う cheap capability id の配列 (変化なしの tick は AI 呼び出しを skip)',
          optional: true,
        },
      },
      returns: {
        type: 'object',
        description: '{ id, name, mode }',
      },
    },
